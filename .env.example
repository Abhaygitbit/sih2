# Groq API Key: Used as the primary high-speed model for statutory & pharmacological Ayurveda IPR intelligence
GROQ_API_KEY="gsk_..."

# GEMINI_API_KEY: Fallback model (Gemini 2.5/Flash) for multimodal & traditional knowledge analysis
GEMINI_API_KEY=""

# Server Port (Render sets this dynamically via $PORT)
PORT=3000
NODE_ENV="production"

# Supabase PostgreSQL Connection String (Transaction Pooler or Direct Connection)
# Example: postgresql://postgres.xxxxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=""

# Optional External ChromaDB instance (e.g., local Docker container or cloud Chroma)
# Leave empty to use the built-in persistent local vector collection
CHROMA_URL="http://localhost:8000"

# Application Host URL
APP_URL="http://localhost:3000"